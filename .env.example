# Copy to .env and edit. Placeholders only - never commit real values.
PORT=3000
NODE_ENV=development
DB_FILE=./data/app.db

# Python agent service (started automatically by the Node server unless AGENT_AUTOSTART=0)
AGENT_URL=http://127.0.0.1:5001
AGENT_AUTOSTART=1
# On Windows the launcher is usually "python"; on macOS/Linux "python3"
PYTHON_BIN=python

# Public HTTPS base URL of this server (for display of the webhook URL), e.g. your ngrok/cloudflared URL
PUBLIC_BASE_URL=

# Meta app secret: REQUIRED to accept real WhatsApp webhooks (signature validation).
# Leave empty for local use - real webhooks are then rejected, simulation still works.
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
